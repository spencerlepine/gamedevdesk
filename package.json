{
  "name": "gamedevdesk",
  "version": "0.1.0",
  "private": true,
  "description": "One-command deploy and teardown of the game dev machines (CPU workstation + GPU box) on AWS with CDK",
  "bin": {
    "gamedevdesk": "bin/gamedevdesk.js"
  },
  "scripts": {
    "build": "tsc && cdk synth --quiet",
    "watch": "tsc -w",
    "bootstrap": "cdk bootstrap",
    "deploy": "cdk deploy --require-approval never",
    "destroy": "cdk destroy --force",
    "diff": "cdk diff",
    "status": "bash scripts/instances.sh status",
    "start:cpu": "bash scripts/instances.sh start cpu",
    "stop:cpu": "bash scripts/instances.sh stop cpu",
    "start:gpu": "bash scripts/instances.sh start gpu",
    "stop:gpu": "bash scripts/instances.sh stop gpu",
    "stop:all": "bash scripts/instances.sh stop all"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.273.0",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "aws-cdk": "^2.1145.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
